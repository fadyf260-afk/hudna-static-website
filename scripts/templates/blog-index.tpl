  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Blog","name":"مدونة هُدنة","url":"https://hudnaapp.com/blog/","inLanguage":"ar","publisher":{"@type":"Organization","name":"هُدنة","url":"https://hudnaapp.com/"}}
  </script>
  <style>
    .blog-hero{padding:64px 0 36px;text-align:center}.blog-hero h1{font-size:clamp(34px,6vw,52px);color:#0E4D49;margin:0 0 12px;font-weight:900}.blog-hero p{max-width:680px;margin:0 auto;color:var(--text-soft);font-size:18px}.blog-toolbar{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:22px 0 28px}.blog-search{font:inherit;border:1px solid var(--line);border-radius:16px;padding:12px 16px;background:#fff;min-width:min(100%,300px);color:var(--text)}.blog-categories{display:flex;gap:8px;flex-wrap:wrap}.blog-categories button{font:inherit;border:1px solid var(--line);border-radius:999px;background:#fff;padding:8px 14px;color:var(--deep-2);cursor:pointer}.blog-categories button[aria-pressed=true]{background:var(--deep);color:#fff}.posts-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.post-card{overflow:hidden;padding:0;display:flex;flex-direction:column}.post-card[hidden]{display:none}.post-cover{aspect-ratio:16/9;background:linear-gradient(135deg,#dcefe9,#f5f0e8);display:grid;place-items:center;color:var(--deep);font-size:42px}.post-content{padding:22px;display:flex;flex:1;flex-direction:column}.post-meta{font-size:13px;color:var(--text-soft);display:flex;gap:10px;flex-wrap:wrap}.post-category{color:var(--deep);font-weight:800}.post-content h2{font-size:21px;margin:10px 0;color:#143f3b;line-height:1.5}.post-content p{font-size:15px;color:var(--text-soft);margin:0 0 16px}.read-more{margin-top:auto;font-weight:800}.empty-state{grid-column:1/-1;text-align:center;color:var(--text-soft);padding:48px 20px}.editor-note{font-size:13px;color:var(--text-soft);margin:28px 0 0;text-align:center}@media(max-width:860px){.posts-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:580px){.posts-grid{grid-template-columns:1fr}.blog-toolbar{align-items:stretch}}
    .post-card:only-child{grid-column:1/-1;max-width:900px;width:100%;margin-inline:auto;display:grid;grid-template-columns:1fr 1.15fr}
    .post-card:only-child .post-cover{height:100%;min-height:280px;aspect-ratio:auto}
    .post-card:only-child .post-content{justify-content:center;padding:30px}
    @media(max-width:680px){.post-card:only-child{display:flex;flex-direction:column}.post-card:only-child .post-cover{aspect-ratio:16/9;min-height:0}}
  </style>
</head>
<body>
  <header class="site-header"><div class="wrap nav">
    <a class="brand-lockup" href="/" aria-label="هُدنة — الصفحة الرئيسية"><span class="mark"><img src="/assets/hudna-icon.svg" alt="" width="34" height="44" /></span><span class="word">هُدنة</span></a>
    <button class="nav-toggle" aria-label="القائمة" aria-expanded="false" onclick="const n=document.getElementById('menu');const o=n.classList.toggle('open');this.setAttribute('aria-expanded',o)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    <nav class="nav-links" id="menu"><a href="/">الرئيسية</a><a href="/blog/" class="active" aria-current="page">المدونة</a><a href="/privacy-policy/">الخصوصية</a><a href="/terms/">الشروط</a><a href="/delete-account/">حذف الحساب</a><a href="/contact/">تواصل معنا</a></nav>
  </div></header>
  <main class="wrap">
    <header class="blog-hero"><span class="section-tag">مساحة معرفة بلا لوم</span><h1>مدونة هُدنة</h1><p>كلام بسيط وموثوق يساعدك تفهم إشارات جسمك ومشاعرك، وتبني علاقة أهدأ مع الأكل خطوة بخطوة.</p></header>
    <section aria-label="المقالات">
      <div class="blog-toolbar"><label class="sr-only" for="post-search">ابحث في المقالات</label><input id="post-search" class="blog-search" type="search" placeholder="ابحث في المقالات…" /><div class="blog-categories" id="categories" aria-label="تصنيف المقالات"></div></div>
      <div class="posts-grid" id="posts" aria-live="polite"><p class="empty-state">جارٍ تحميل المقالات…</p></div>
    </section>
    <p class="editor-note">المحتوى للتثقيف العام ولا يُعد تشخيصًا أو بديلًا عن استشارة مختص.</p>
  </main>
  <footer class="site-footer"><div class="wrap"><div class="footer-top"><span class="mark"><img src="/assets/hudna-icon.svg" alt="" width="26" height="34" /></span><span class="name">هُدنة — الأكل العاطفي</span></div><nav class="footer-links"><a href="/">الرئيسية</a><a href="/privacy-policy/">الخصوصية</a><a href="/terms/">الشروط</a><a href="/contact/">تواصل معنا</a></nav><div class="copyright"><img class="leaf" src="/assets/hudna-footer-leaf.svg" alt="" /><span>© 2026 هُدنة. كل الحقوق محفوظة.</span></div></div></footer>
  <script>
    const postsRoot = document.getElementById('posts');
    const search = document.getElementById('post-search');
    const categoryRoot = document.getElementById('categories');
    let articles = [];
    let selectedCategory = 'الكل';
    const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    function render() {
      const query = search.value.trim().toLocaleLowerCase('ar');
      const visible = articles.filter(post => (selectedCategory === 'الكل' || post.category === selectedCategory) && (`${post.title} ${post.description} ${post.category} ${(post.tags || []).join(' ')}`).toLocaleLowerCase('ar').includes(query));
      postsRoot.innerHTML = visible.length ? visible.map(post => `<article class="card post-card"><div class="post-cover" aria-hidden="true">${post.cover ? `<img src="${escapeHtml(post.cover)}" alt="" loading="lazy" width="640" height="360" style="width:100%;height:100%;object-fit:cover">` : 'هُدنة'}</div><div class="post-content"><div class="post-meta"><span class="post-category">${escapeHtml(post.category)}</span><time datetime="${escapeHtml(post.date)}">${new Intl.DateTimeFormat('ar-EG',{year:'numeric',month:'long',day:'numeric'}).format(new Date(`${post.date}T12:00:00`))}</time><span>${escapeHtml(post.readingTime || 4)} دقائق قراءة</span></div><h2><a href="/blog/${encodeURIComponent(post.slug)}/">${escapeHtml(post.title)}</a></h2><p>${escapeHtml(post.description)}</p><a class="read-more" href="/blog/${encodeURIComponent(post.slug)}/" aria-label="اقرأ مقال ${escapeHtml(post.title)}">اقرأ المقال ←</a></div></article>`).join('') : '<p class="empty-state">لا توجد مقالات تطابق بحثك الآن.</p>';
    }
    function renderCategories() {
      const categories = ['الكل', ...new Set(articles.map(post => post.category).filter(Boolean))];
      categoryRoot.innerHTML = categories.map(category => `<button type="button" aria-pressed="${category === selectedCategory}" data-category="${escapeHtml(category)}">${escapeHtml(category)}</button>`).join('');
      categoryRoot.addEventListener('click', event => { const button = event.target.closest('button[data-category]'); if (!button) return; selectedCategory = button.dataset.category; renderCategories(); render(); }, {once:true});
    }
    search.addEventListener('input', render);
    fetch('/blog/posts.json').then(response => { if (!response.ok) throw new Error('posts'); return response.json(); }).then(data => { articles = data.filter(post => post.status === 'published').sort((a,b) => b.date.localeCompare(a.date)); renderCategories(); render(); }).catch(() => { categoryRoot.textContent = ''; });
  </script>
</body>
</html>
